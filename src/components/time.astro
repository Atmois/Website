<span id="localTime">00:00</span>
<script type="module" is:inline>
    function setLondonTime() {
        const now = new Date();
        const options = {
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
            timeZone: "Europe/London",
        };
        const timeString = new Intl.DateTimeFormat("en-GB", options).format(
            now,
        );
        document.getElementById("localTime").innerHTML = timeString;
    }
    setLondonTime();
    setInterval(setLondonTime, 10000);
</script>
